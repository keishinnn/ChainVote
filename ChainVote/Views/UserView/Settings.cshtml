@{
    ViewData["Title"] = "Settings";
    Layout = "~/Views/Shared/_UserViewLayout.cshtml";
}

<div class="container mt-5 mb-5 position-relative">

    <a href="/UserView/UserViewElections"
       class="btn btn-outline-dark rounded-circle shadow-sm position-absolute top-0 end-0 mt-4 me-4"
       title="Close">
        <i class="bi bi-x-lg"></i>
    </a>


    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="text-center mb-4">
                <h2 class="fw-bold text-dark">Settings</h2>
                <p class="text-muted">Manage your account details.</p>
            </div>

            <!-- Email Settings -->
            <div class="card shadow-sm mb-4 border-0 rounded-4">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-semibold"><i class="bi bi-envelope-fill me-2 text-dark"></i>Email</h5>
                        <p class="text-muted small mb-0">Edit your registered email address</p>
                    </div>
                    <a href="/User/EditEmail" class="btn btn-outline-dark rounded-pill px-4">Edit</a>
                </div>
            </div>

            <!-- Password Settings -->
            <div class="card shadow-sm mb-4 border-0 rounded-4">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-semibold"><i class="bi bi-shield-lock-fill me-2 text-dark"></i>Password</h5>
                        <p class="text-muted small mb-0">Change your account password</p>
                    </div>
                    <a href="/User/EditPassword" class="btn btn-outline-dark rounded-pill px-4">Edit</a>
                </div>
            </div>

            <!-- Delete Account -->
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-semibold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Account</h5>
                        <p class="text-muted small mb-0">Permanently remove your account</p>
                    </div>
                    <form method="post" action="/UserView/DeleteAccount" onsubmit="return confirm('Are you sure you want to delete your account?');">
                        <button type="submit" class="btn btn-danger rounded-pill px-4">Delete</button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
