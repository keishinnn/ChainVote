@{
    ViewData["Title"] = "About";
    Layout = "~/Views/Shared/_UserViewLayout.cshtml";
}

<!-- About Section Container -->
<section class="py-5">
    <div class="container text-center animate-fadein">

        <!-- Section Header -->
        <h1 class="display-5 fw-bold mb-4">About the Project</h1>

        <!-- Project Description -->
        <p class="lead text-muted mb-4">
            The <strong>ChainVote Voting System</strong> is a modern digital platform built with ASP.NET Core MVC and SQL Server,
            designed to make voting in academic institutions secure, transparent, and efficient.
        </p>

        <!-- Feature Cards Section -->
        <div class="row g-4 mt-5">

            <!-- Secure Voting Card -->
            <div class="col-md-4">
                <div class="card shadow h-100 border-0 animate-slideup">
                    <div class="card-body">
                        <h5 class="card-title">🔐 Secure Voting</h5>
                        <p class="card-text">Votes are stored securely and validated to prevent tampering or manipulation.</p>
                    </div>
                </div>
            </div>

            <!-- Role-Based Access Card -->
            <div class="col-md-4">
                <div class="card shadow h-100 border-0 animate-slideup">
                    <div class="card-body">
                        <h5 class="card-title">👥 Role-Based Access</h5>
                        <p class="card-text">Separate panels for voters and administrators for a clean, controlled, and secure user experience.</p>
                    </div>
                </div>
            </div>

            <!-- Real-Time Insights Card -->
            <div class="col-md-4">
                <div class="card shadow h-100 border-0 animate-slideup">
                    <div class="card-body">
                        <h5 class="card-title">📊 Real-Time Insights</h5>
                        <p class="card-text">Dynamic dashboard and analytics provide real-time insights into elections and voter turnout.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Button to Explore Elections -->
        <div class="mt-5">
            <a href="/UserView/Elections" class="btn btn-primary btn-lg px-4">Explore Elections</a>
        </div>
    </div>
</section>
