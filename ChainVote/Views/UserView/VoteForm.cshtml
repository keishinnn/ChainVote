@{
    ViewData["Title"] = "Vote Form";
    Layout = "~/Views/Shared/_UserViewLayout.cshtml";

    var eventId = ViewBag.EventId ?? 0;
    var alreadyVoted = ViewBag.AlreadyVoted != null ? (bool)ViewBag.AlreadyVoted : false;
}

<style>
    .candidate-card {
        cursor: pointer;
        transition: box-shadow 0.3s ease, transform 0.2s ease;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 4px 10px rgb(0 0 0 / 0.05);
        padding: 1rem;
        user-select: none;
    }

        .candidate-card:hover,
        .candidate-card input[type="radio"]:checked + label {
            box-shadow: 0 8px 20px rgb(0 0 0 / 0.15);
            transform: translateY(-5px);
            border-color: #28a745;
            background-color: #e9f7ef;
        }

        .candidate-card input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }

        .candidate-card label {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-weight: 600;
            font-size: 1.1rem;
            color: #333;
            width: 100%;
            padding-left: 2rem;
            position: relative;
        }

            .candidate-card label i {
                font-size: 2.5rem;
                color: #6c757d;
                flex-shrink: 0;
            }

            .candidate-card label::before {
                content: "";
                position: absolute;
                left: 0;
                top: 50%;
                transform: translateY(-50%);
                width: 20px;
                height: 20px;
                border: 2.5px solid #ccc;
                border-radius: 50%;
                background: white;
                transition: border-color 0.3s ease;
            }

        .candidate-card input[type="radio"]:checked + label::before {
            border-color: #28a745;
            background: #28a745;
        }

        .candidate-card input[type="radio"]:checked + label::after {
            content: "";
            position: absolute;
            left: 6px;
            top: 50%;
            transform: translateY(-50%);
            width: 8px;
            height: 8px;
            background: white;
            border-radius: 50%;
        }
</style>

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-person-check-fill me-2 text-success"></i>Vote Form</h2>

    @if (alreadyVoted)
    {
        <div class="alert alert-info shadow-sm">
            You have already voted in this election.
        </div>
    }
    else
    {
        <div id="candidatesContainer" class="mb-5">
            <div class="text-muted">Loading candidates...</div>
        </div>
    }
</div>

<!-- Vote Confirmation Modal -->
<div class="modal fade" id="voteConfirmationModal" tabindex="-1" aria-labelledby="voteConfirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="voteConfirmationModalLabel"><i class="bi bi-check2-circle me-2"></i>Confirm Your Vote</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="voteSummaryList">
                    <!-- Vote summary will be injected here -->
                </div>
                <div class="alert alert-warning mt-3">
                    Please review your selections before confirming. Once submitted, votes cannot be changed.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="confirmVoteBtn" type="button" class="btn btn-success">Confirm and Submit</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            const eventId = @ViewBag.EventId;

            if (!eventId) {
                $('#candidatesContainer').html('<div class="alert alert-warning">No election event selected.</div>');
                return;
            }

        $.get(`/VoteRecords/GetPositionsAndCandidates?eventId=${eventId}`, function(data) {
            if (!data || data.length === 0) {
                $('#candidatesContainer').html('<div class="alert alert-warning">No candidates or positions found.</div>');
                return;
            }

            // Group by positionTitle, merging candidates
            const groupedPositions = {};

            data.forEach(pos => {
                if (!groupedPositions[pos.positionTitle]) {
                    groupedPositions[pos.positionTitle] = {
                        positionTitle: pos.positionTitle,
                        candidates: []
                    };
                }
                // Add all candidates for this position title
                groupedPositions[pos.positionTitle].candidates.push(...pos.candidates);
            });

            let html = '';

            Object.keys(groupedPositions).forEach(positionTitle => {
                const pos = groupedPositions[positionTitle];
                const groupName = `position_${positionTitle.replace(/\s+/g, '_').toLowerCase()}`; // e.g. position_president

                html += `
                    <div class="mb-5">
                        <h5 class="fw-bold mb-4 text-success">${pos.positionTitle}</h5>
                        <div class="row">`;

                pos.candidates.forEach(c => {
                    const radioId = `radio_${groupName}_${c.candidateId}`;
                    html += `
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="candidate-card position-relative">
                                <input type="radio" name="${groupName}" id="${radioId}" value="${c.candidateId}" />
                                <label for="${radioId}">
                                    <i class="bi bi-person-circle"></i>
                                    <span>${c.fullName} <strong>(${c.organizationName})</strong></span>
                                </label>
                            </div>
                        </div>`;
                });

                // None option per position group
                const noneId = `radio_${groupName}_none`;
                html += `
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="candidate-card position-relative">
                            <input type="radio" name="${groupName}" id="${noneId}" value="none" />
                            <label for="${noneId}">
                                <i class="bi bi-x-circle text-danger"></i>
                                <span><em>None</em></span>
                            </label>
                        </div>
                    </div>`;

                html += '</div></div>';
            });

                html += `<div class="text-end mt-4">
                            <button type="button" id="submitVoteBtn" class="btn btn-success btn-lg shadow-sm">
                                Submit Vote
                            </button>
                         </div>`;

            $('#candidatesContainer').html(`${html}`);


            // Card selection styling and event bindings
            $('.candidate-card').on('click', function (e) {
                if (e.target.tagName.toLowerCase() !== 'input') {
                    $(this).find('input[type="radio"]').prop('checked', true).trigger('change');
                }
            });

            $('#voteForm input[type="radio"]').on('change', function () {
                const groupName = $(this).attr('name');
                $(`input[name='${groupName}']`).each(function () {
                    if ($(this).is(':checked')) {
                        $(this).closest('.candidate-card').addClass('selected');
                    } else {
                        $(this).closest('.candidate-card').removeClass('selected');
                    }
                });
            });

        $('#candidatesContainer').on('click', '#submitVoteBtn', function (e) {
            e.preventDefault();

            let votes = [];
            let allSelected = true;
            let summaryHtml = '';

            $('.validation-message').remove();

            for (const positionTitle in groupedPositions) {
                const groupName = `position_${positionTitle.replace(/\s+/g, '_').toLowerCase()}`;
                const selected = $(`input[name='${groupName}']:checked`);

                if (selected.length === 0) {
                    allSelected = false;
                    const section = $(`input[name='${groupName}']`).first().closest('.mb-5');
                    section.append(`<div class="validation-message text-danger mt-2">Please select a candidate or 'None' for <strong>${positionTitle}</strong>.</div>`);
                } else {
                    const val = selected.val();
                    const label = selected.siblings('label').text().trim();

                    summaryHtml += `
                        <div class="mb-2">
                            <strong>${positionTitle}:</strong> ${val === 'none' ? '<em>None</em>' : label}
                        </div>`;

                    if (val !== 'none') {
                        votes.push({ candidateId: parseInt(val) });
                    }
                }
            }

            if (!allSelected) {
                $('html, body').animate({
                    scrollTop: $('.validation-message').first().offset().top - 100
                }, 500);
                return;
            }

            // Show modal and render vote summary
            $('#voteSummaryList').html(summaryHtml);
            const voteModal = new bootstrap.Modal(document.getElementById('voteConfirmationModal'));
            voteModal.show();

            // Store votes temporarily for confirmation
            $('#confirmVoteBtn').off('click').on('click', function () {
                const submission = {
                    eventId: eventId,
                    votes: votes
                };

                $.ajax({
                    url: '/VoteRecords/SubmitVote',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(submission),
                    success: function () {
                        voteModal.hide();
                        alert('Your vote has been submitted successfully!');
                        window.location.href = '/UserView/Elections';
                    },
                    error: function (xhr) {
                        alert('Error submitting vote: ' + xhr.responseText);
                    }
                });
            });
        });


        });

        });
    </script>
}
