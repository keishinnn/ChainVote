@{
    ViewData["Title"] = "Vote";
    Layout = "~/Views/Shared/_UserViewLayout.cshtml";
}

<div class="container">
    <h2 class="mb-4"><i class="bi bi-check2-square me-2"></i>Cast Your Vote</h2>

    <div class="row">
        @* Loop through partylists or candidates dynamically *@
        @* Replace with a foreach loop if you're passing a model *@

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <img src="~/images/party1-logo.png" alt="Party Logo" class="img-fluid rounded-circle mb-3" style="width: 100px; height: 100px;">
                    <h5 class="card-title">Partylist Name</h5>
                    <p class="card-text">Short description or motto of the party.</p>
                    <form method="post" asp-action="SubmitVote" asp-controller="UserView">
                        <input type="hidden" name="partyId" value="1" />
                        <button type="submit" class="btn btn-success w-100"><i class="bi bi-send-fill me-1"></i> Vote</button>
                    </form>
                </div>
            </div>
        </div>

        @* Repeat the card for each party or candidate *@
    </div>
</div>
