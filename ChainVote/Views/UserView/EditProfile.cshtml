@{
    ViewData["Title"] = "EditProfile";
    Layout = "~/Views/Shared/_UserViewLayout.cshtml";
}

<!-- Main container for the edit profile card -->
<div class="container mt-5">
    <div class="card shadow rounded-3">

        <!-- Card body for form content -->
        <div class="card-body">
            <h3 class="card-title mb-4">Edit Profile</h3>

            <!-- Form to handle profile update -->
            <form method="post" action="/User/EditProfile">

                <!-- Full Name input field -->
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" class="form-control" name="FullName" value="John Doe" required>
                </div>

                <!-- Email input field -->
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" name="Email" value="johndoe@example.com" required>
                </div>

                <!-- Username input field -->
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input type="text" class="form-control" name="Username" value="johndoe123" required>
                </div>

                <!-- Submit and cancel buttons -->
                <button type="submit" class="btn btn-success">Save Changes</button>
                <a href="/User/ViewProfile" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
