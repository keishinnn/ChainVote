@model ChainVote.Models.ViewModels.ElectionStatsViewModel

@{
    // Set the title of the page and define the layout for user views
    ViewData["Title"] = "User View Election Results";
    Layout = "~/Views/Shared/_UserViewLayout.cshtml";
}

<div class="container mt-4">

    <!-- Display the event title and duration -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">@Model.EventTitle</h2>
        <p class="text-muted">Started on <strong>@Model.EventStartDate.ToString("MMMM dd, yyyy")</strong></p>
        <p class="text-muted">Ended on <strong>@Model.EventEndDate.ToString("MMMM dd, yyyy")</strong></p>
        <hr />
    </div>

    <!-- Display overall election statistics in three cards -->
    <div class="row justify-content-center mb-5">
        <!-- Total eligible voters -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-uppercase text-muted">Total Eligible Voters</h6>
                    <h3 class="fw-bold">@Model.TotalVoters</h3>
                </div>
            </div>
        </div>

        <!-- Total votes cast -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-uppercase text-muted">Total Votes Cast</h6>
                    <h3 class="fw-bold text-success">@Model.VotesCast</h3>
                </div>
            </div>
        </div>

        <!-- Voter turnout percentage -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-uppercase text-muted">Voter Turnout</h6>
                    <h3 class="fw-bold">@Model.VoterTurnoutPercent.ToString("F2")%</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Loop through each position to display candidate results -->
    @foreach (var position in Model.Positions)
    {
        // Get the highest vote count for this position
        var topVote = position.Candidates.Max(c => c.VoteCount);

        <div class="mb-5">
            <!-- Display position title -->
            <h4 class="mb-3 text-primary">@position.PositionTitle</h4>
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <!-- Display all candidates for the position, ordered by vote count -->
                    @foreach (var candidate in position.Candidates.OrderByDescending(c => c.VoteCount))
                    {
                        // Determine if the current candidate is a winner
                        var isWinner = candidate.VoteCount == topVote && topVote > 0;

                        // Calculate vote percentage (avoid division by zero)
                        var percent = Model.VotesCast == 0 ? 0 : ((double)candidate.VoteCount / Model.VotesCast) * 100;

                        // Style progress bar based on winner status
                        var progressBarClass = isWinner ? "bg-primary" : "bg-secondary";

                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <!-- Candidate name and 'Winner' badge if applicable -->
                                <strong class="@(isWinner ? "text-primary" : "")">
                                    @candidate.CandidateName
                                    @if (isWinner)
                                    {
                                        <span class="badge bg-primary ms-2">Winner</span>
                                    }
                                </strong>

                                <!-- Vote count and percentage -->
                                <span class="text-muted small">@candidate.VoteCount votes (@percent.ToString("F1")%)</span>
                            </div>

                            <!-- Vote percentage progress bar -->
                            <div class="progress" style="height: 24px;">
                                <div class="progress-bar @progressBarClass" role="progressbar"
                                     style="width: @percent.ToString("F2")%;" aria-valuenow="@percent.ToString("F0")"
                                     aria-valuemin="0" aria-valuemax="100">
                                    @percent.ToString("F1")%
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Navigation button to go back to the election list -->
    <div class="text-end mt-4">
        <a asp-controller="UserView" asp-action="UserViewElections" class="btn btn-outline-secondary">Back to Elections</a>
    </div>
</div>
