@{
    ViewData["Title"] = "Accounts";
    Layout = "~/Views/Shared/_AdminViewLayout.cshtml";
}

<!-- Page heading -->
<h2 class="mb-4">Registered Accounts</h2>

<!-- Hidden field storing the AJAX URL for fetching registered accounts -->
<input type="hidden" id="getAccountsUrl" value="@Url.Action("GetAccounts", "RegisteredAccounts")" />

<!-- Table for displaying registered user accounts -->
<table id="accountsTable" class="table table-bordered table-hover shadow-sm">
    <thead class="table-light">
        <tr>
            <th>Student ID</th>
            <th>Full Name</th>
            <th>Course</th>
            <th>Year Level</th>
            <th>Section</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        <!-- Table body will be populated via AJAX -->
    </tbody>
</table>

@section Scripts {
    <script>
        // Initialize DataTable on page load
        $(document).ready(function () {
            $('#accountsTable').DataTable({
                // Enable processing indicator
                "processing": true,

                // Use client-side processing
                "serverSide": false,

                // Configure AJAX request for fetching data
                "ajax": {
                    "url": '@Url.Action("GetAccounts", "RegisteredAccounts")',
                    "type": 'GET',
                    "dataSrc": "data" // Property containing array of data
                },

                // Define columns to map the data
                "columns": [
                    { "data": "studentId" },
                    { "data": "fullName" },
                    { "data": "course" },
                    { "data": "yearLevel" },
                    { "data": "section" },
                    { "data": "email" }
                ]
            });
        });
    </script>
}
