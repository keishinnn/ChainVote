@{
    ViewData["Title"] = "Accounts";
    Layout = "~/Views/Shared/_AdminViewLayout.cshtml";
}

<h2 class="mb-4">Registered Accounts</h2>

<input type="hidden" id="getAccountsUrl" value="@Url.Action("GetAccounts", "RegisteredAccounts")" />

<table id="accountsTable" class="table table-bordered table-hover shadow-sm">
    <thead class="table-light">
        <tr>
            <th>Student ID</th>
            <th>Full Name</th>
            <th>Course</th>
            <th>Year Level</th>
            <th>Section</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#accountsTable').DataTable({
                "processing": true,
                "serverSide": false,
                "ajax": {
                    "url": '@Url.Action("GetAccounts", "RegisteredAccounts")',
                    "type": 'GET',
                    "dataSrc": "data"
                },
                "columns": [
                    { "data": "studentId" },
                    { "data": "fullName" },
                    { "data": "course" },
                    { "data": "yearLevel" },
                    { "data": "section" },
                    { "data": "email" }
                ]
            });
        });
    </script>
}
