@{
    ViewData["Title"] = "Manage Candidates";
    Layout = "~/Views/Shared/_AdminViewLayout.cshtml";
}

<h2 class="mb-4">Manage Candidates</h2>

<!-- Ready for Deployment -->
<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Ready for Deployment</h5>
    </div>
    <div class="card-body">
        <table id="readyCandidatesTable" class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Course</th>
                    <th>Year Level</th>
                    <th>Section</th>
                    <th>Email</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Deployed Candidates -->
<div class="card shadow mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">Deployed Candidates</h5>
    </div>
    <div class="card-body">
        <table id="deployedCandidatesTable" class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Course</th>
                    <th>Year Level</th>
                    <th>Section</th>
                    <th>Email</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- Modal for Confirming Candidate Deployment -->
<div class="modal fade" id="confirmDeployModal" tabindex="-1" aria-labelledby="confirmDeployModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeployModalLabel">Confirm Deployment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to deploy this candidate?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmDeployBtn">Deploy</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Confirming Deletion of Deployed Candidate -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this deployed candidate?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let candidateToDeploy = '';
        let candidateToDelete = '';

        function setCandidateToDeploy(studentId) {
            candidateToDeploy = studentId;
            $('#confirmDeployModal').modal('show');
        }

        function setCandidateToDelete(studentId) {
            candidateToDelete = studentId;
            $('#confirmDeleteModal').modal('show');
        }

        $(document).ready(function () {

            // Ready for Deployment Table
            $('#readyCandidatesTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: '@Url.Action("GetAccounts", "RegisteredAccounts")',
                    type: 'GET',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'studentId' },
                    { data: 'fullName' },
                    { data: 'course' },
                    { data: 'yearLevel' },
                    { data: 'section' },
                    { data: 'email' },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<button class="btn btn-success btn-sm" onclick="setCandidateToDeploy('${row.studentId}')">Deploy</button>`;
                        },
                        orderable: false
                    }
                ],
                language: {
                    searchPlaceholder: "Search...",
                    search: ""
                }
            });

            // Deployed Candidates Table
            $('#deployedCandidatesTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: '@Url.Action("GetCandidates", "CandidatesData")',
                    type: 'GET',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'studentId' },
                    { data: 'fullName' },
                    { data: 'course' },
                    { data: 'yearLevel' },
                    { data: 'section' },
                    { data: 'email' },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<button class="btn btn-danger btn-sm" onclick="setCandidateToDelete('${row.studentId}')">Remove</button>`;
                        },
                        orderable: false
                    }
                ],
                language: {
                    searchPlaceholder: "Search...",
                    search: ""
                }
            });

            // Deploy Candidate Action
            $('#confirmDeployBtn').on('click', function () {
                $.ajax({
                    url: '@Url.Action("DeployCandidate", "CandidatesData")',
                    method: 'POST',
                    data: { studentId: candidateToDeploy },
                    success: function () {
                        $('#readyCandidatesTable').DataTable().ajax.reload();
                        $('#deployedCandidatesTable').DataTable().ajax.reload();
                        $('#confirmDeployModal').modal('hide');
                    },
                    error: function (xhr) {
                        alert(xhr.responseText || "Failed to deploy candidate.");
                    }
                });
            });

            // Delete Candidate Action
            $('#confirmDeleteBtn').on('click', function () {
                $.ajax({
                    url: '@Url.Action("DeleteCandidate", "CandidatesData")',
                    method: 'POST',
                    data: { studentId: candidateToDelete },
                    success: function () {
                        $('#deployedCandidatesTable').DataTable().ajax.reload();
                        $('#confirmDeleteModal').modal('hide');
                    },
                    error: function (xhr) {
                        alert(xhr.responseText || "Failed to remove candidate.");
                    }
                });
            });
        });
    </script>
}
