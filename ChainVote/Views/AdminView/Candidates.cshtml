@{
    ViewData["Title"] = "Manage Candidates";
    Layout = "~/Views/Shared/_AdminViewLayout.cshtml";
}

<h2 class="mb-4">Manage Candidates</h2>

<!-- SECTION: Ready for Deployment Table -->
<div class="card shadow mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Ready for Deployment</h5>
    </div>
    <div class="card-body">
        <table id="readyCandidatesTable" class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Course</th>
                    <th>Year Level</th>
                    <th>Section</th>
                    <th>Email</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- SECTION: Deployed Candidates Table -->
<div class="card shadow mb-4">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">Deployed Candidates</h5>
    </div>
    <div class="card-body">
        <table id="deployedCandidatesTable" class="table table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Course</th>
                    <th>Year Level</th>
                    <th>Section</th>
                    <th>Email</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<!-- MODAL: Candidate Deployment Selection -->
<div class="modal fade" id="deployModal" tabindex="-1" aria-labelledby="deployModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deployModalLabel">Deploy Candidate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Organization Dropdown -->
                <div class="mb-3">
                    <label for="organizationDropdown" class="form-label">Organization</label>
                    <select id="organizationDropdown" class="form-control">
                        <option value="">Choose an Organization</option>
                    </select>
                </div>

                <!-- Position Dropdown -->
                <div class="mb-3">
                    <label for="positionDropdown" class="form-label">Position</label>
                    <select id="positionDropdown" class="form-control">
                        <option value="">Choose a Position</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="deployBtn">Deploy</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: Confirm Deletion of Deployed Candidate -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this deployed candidate?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Store IDs of candidate to deploy or delete
        let candidateToDeploy = '';
        let candidateToDelete = '';

        // Assign candidate ID for deployment and open deployment modal
        function setCandidateToDeploy(studentId) {
            candidateToDeploy = studentId;
            loadOrganizations();
            $('#deployModal').modal('show');
        }

        // Assign candidate ID for deletion and open confirmation modal
        function setCandidateToDelete(studentId) {
            candidateToDelete = studentId;
            $('#confirmDeleteModal').modal('show');
        }

        // Load list of organizations from server
        function loadOrganizations() {
            $.ajax({
                url: '@Url.Action("GetOrganizations", "CandidatesData")',
                method: 'GET',
                success: function (data) {
                    let organizationsDropdown = $('#organizationDropdown');
                    organizationsDropdown.empty();
                    organizationsDropdown.append('<option value="">Choose an Organization</option>');
                    data.forEach(org => {
                        organizationsDropdown.append(`<option value="${org.id}">${org.name}</option>`);
                    });
                    loadPositions(); // Load positions after organizations
                },
                error: function (xhr) {
                    alert(xhr.responseText || "Failed to fetch organizations.");
                }
            });
        }

        // Load available positions for selected organization
        function loadPositions() {
            const organizationId = $('#organizationDropdown').val();
            if (!organizationId) return;

            $.ajax({
                url: '@Url.Action("GetAvailablePositions", "CandidatesData")',
                method: 'GET',
                data: { organizationId: organizationId },
                success: function (data) {
                    let positionsDropdown = $('#positionDropdown');
                    positionsDropdown.empty();
                    positionsDropdown.append('<option value="">Choose a Position</option>');
                    data.forEach(position => {
                        positionsDropdown.append(`<option value="${position.id}">${position.title}</option>`);
                    });
                },
                error: function (xhr) {
                    alert(xhr.responseText || "Failed to fetch positions.");
                }
            });
        }

        // Deploy candidate to selected organization and position
        $('#deployBtn').on('click', function () {
            const organizationId = $('#organizationDropdown').val();
            const positionId = $('#positionDropdown').val();

            if (!organizationId || !positionId) {
                alert("Please select both organization and position.");
                return;
            }

            $.ajax({
                url: '@Url.Action("DeployCandidate", "CandidatesData")',
                method: 'POST',
                data: {
                    studentId: candidateToDeploy,
                    organizationId: organizationId,
                    positionId: positionId
                },
                success: function () {
                    $('#readyCandidatesTable').DataTable().ajax.reload();
                    $('#deployedCandidatesTable').DataTable().ajax.reload();
                    $('#deployModal').modal('hide');
                },
                error: function (xhr) {
                    alert(xhr.responseText || "Failed to deploy candidate.");
                }
            });
        });

        // Delete candidate from deployed list
        $('#confirmDeleteBtn').on('click', function () {
            if (!candidateToDelete) return;

            $.ajax({
                url: '@Url.Action("DeleteCandidate", "CandidatesData")',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(candidateToDelete),
                success: function () {
                    $('#readyCandidatesTable').DataTable().ajax.reload();
                    $('#deployedCandidatesTable').DataTable().ajax.reload();
                    $('#confirmDeleteModal').modal('hide');
                    candidateToDelete = '';
                },
                error: function (xhr) {
                    alert(xhr.responseText || "Failed to delete candidate.");
                }
            });
        });

        // Initialize DataTables on page load
        $(document).ready(function () {
            // Initialize Ready for Deployment table
            $('#readyCandidatesTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: '@Url.Action("GetReadyForDeployment", "CandidatesData")',
                    type: 'GET',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'studentId' },
                    { data: 'fullName' },
                    { data: 'course' },
                    { data: 'yearLevel' },
                    { data: 'section' },
                    { data: 'email' },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<button class="btn btn-success btn-sm" onclick="setCandidateToDeploy('${row.studentId}')">Deploy</button>`;
                        },
                        orderable: false
                    }
                ],
                language: {
                    searchPlaceholder: "Search...",
                    search: ""
                }
            });

            // Initialize Deployed Candidates table
            $('#deployedCandidatesTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: '@Url.Action("GetCandidates", "CandidatesData")',
                    type: 'GET',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'studentId' },
                    { data: 'fullName' },
                    { data: 'course' },
                    { data: 'yearLevel' },
                    { data: 'section' },
                    { data: 'email' },
                    {
                        data: null,
                        render: function (data, type, row) {
                            return `<button class="btn btn-danger btn-sm" onclick="setCandidateToDelete('${row.studentId}')">Remove</button>`;
                        },
                        orderable: false
                    }
                ],
                language: {
                    searchPlaceholder: "Search...",
                    search: ""
                }
            });
        });

        // Reload positions when organization dropdown value changes
        $(document).on('change', '#organizationDropdown', function () {
            loadPositions();
        });
    </script>
}
