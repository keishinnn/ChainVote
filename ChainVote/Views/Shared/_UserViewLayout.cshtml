@* Views/Shared/_UserViewLayout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - UserView</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/user.css" />

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" href="/UserView/Index">🗳️ ChainVote</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item me-3">
                            <a class="nav-link" href="/UserView/Index"><i class="bi bi-house-door"></i> Home</a>
                        </li>
                        <li class="nav-item me-3">
                            <a class="nav-link" href="/UserView/Vote"><i class="bi bi-check2-square"></i> Vote</a>
                        </li>
                        <li class="nav-item me-3">
                            <a class="nav-link" href="/UserView/Elections"><i class="bi bi-bar-chart-line"></i> Elections</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/UserView/About"><i class="bi bi-info-circle"></i> About</a>
                        </li>
                    </ul>


                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i> Profile
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="profileDropdown">
                                <li><a class="dropdown-item" href="/UserView/ViewProfile"><i class="bi bi-person-lines-fill me-2"></i>View Profile</a></li>
                                <li><a class="dropdown-item" href="/UserView/EditProfile"><i class="bi bi-pencil-square me-2"></i>Edit Profile</a></li>
                                <li><a class="dropdown-item" href="/UserView/Settings"><i class="bi bi-gear me-2"></i>Settings</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="text-center mt-5 mb-3 text-muted">
        &copy; 2025 - ChainVote
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
