@* Views/Shared/_UserViewLayout.cshtml *@
<!DOCTYPE html>
<html lang="en" class="user-layout">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ChainVote</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 user-layout">

    <!-- Header / Navbar -->
    <header>
        <nav class="navbar fixed-top navbar-expand-lg shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-white ms-5" href="/UserView/Index">ChainVote</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-4">
                        <li class="nav-item me-3">
                            <a class="nav-link text-white" href="/UserView/Index"><i class="bi bi-house-door"></i> Home</a>
                        </li>
                        <li class="nav-item me-3">
                            <a class="nav-link text-white" href="/UserView/Vote"><i class="bi bi-check2-square"></i> Vote</a>
                        </li>
                        <li class="nav-item me-3">
                            <a class="nav-link text-white" href="/UserView/Elections"><i class="bi bi-bar-chart-line"></i> Elections</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/UserView/About"><i class="bi bi-info-circle"></i> About</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white d-flex align-items-center" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1 fs-5"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow p-3">
                                <li class="d-flex align-items-start mb-2">
                                    <i class="bi bi-person-circle fs-3 me-2 text-primary"></i>
                                    <div>
                                        <div class="fw-semibold">@User.Identity?.Name</div>
                                        <small class="text-muted">ID: @ViewBag.StudentId</small>
                                    </div>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/UserView/Settings"><i class="bi bi-gear me-2"></i> Settings</a></li>
                                <li><a class="dropdown-item" href="/UserView/Display"><i class="bi bi-display me-2"></i> Display</a></li>
                                <li><a class="dropdown-item" href="/UserView/Feedback"><i class="bi bi-chat-left-text me-2"></i> Give Feedback</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i> Log Out</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-grow-1 pt-5 mt-4">
        <div class="container main-content">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="mt-auto border-top text-muted py-3 bg-light">
        <div class="container text-center">
            &copy; 2025 - ChainVote
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
