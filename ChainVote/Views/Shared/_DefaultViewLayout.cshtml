@* Views/Shared/_DefaultViewLayout.cshtml *@

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DefaultView</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Bootstrap Icons (only include once in your layout or head) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

</head>

<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar fixed-top navbar-expand-sm navbar-light bg-white border-bottom box-shadow shadow-sm">
            <div class="container">
                <!-- Blockchain Voting Brand -->
                <a class="navbar-brand fw-bold me-5" href="/">ChainVote</a>

                <!-- Navbar Toggler for mobile view -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarDefault"
                        aria-controls="navbarDefault" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarDefault">
                    <!-- Navbar Links for Home, Elections, About -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/DefaultView/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/DefaultView/DefaultViewElections">Elections</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/DefaultView/About">About</a>
                        </li>
                    </ul>
                    <!-- Login and Register Buttons -->
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="btn btn-outline-primary me-2" href="/Account/Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary text-white" href="/Account/Register">Register</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <div class="container mt-4 flex-grow-1">
        <main class="main-content">
            <div class="container">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Footer -->
    <footer class="mt-auto border-top text-muted py-3 bg-light">
        <div class="container text-center">
            &copy; 2025 - ChainVote
        </div>
    </footer>

    <!-- Script Inclusions -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Render Additional Scripts if Available -->
    @RenderSection("Scripts", required: false)

</body>

</html>
