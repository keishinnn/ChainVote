<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Meta tags for charset and responsive viewport -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Page title, dynamic based on ViewData -->
    <title>@ViewData["Title"] - AdminView</title>

    <!-- Bootstrap CSS for styling -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons for icon fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- jQuery library (required for DataTables and validation plugins) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- jQuery Validation plugins for client-side form validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>

    <!-- DataTables CSS for enhanced table styling -->
    <link href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" rel="stylesheet" />
</head>
<body>
    <div class="d-flex" style="min-height: 100vh;">
        <!-- Sidebar navigation fixed to the left -->
        <nav class="bg-dark text-white p-3 position-fixed h-100" style="width: 250px;">
            <!-- Sidebar title with icon -->
            <h4 class="text-white fw-bold mb-4"><i class="bi bi-shield-lock me-2"></i>ChainVote Admin</h4>

            <!-- Navigation links for admin sections -->
            <ul class="nav flex-column mb-auto">
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" href="/AdminView/Dashboard">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" href="/EventsData/Elections">
                        <i class="bi bi-bar-chart me-2"></i>Elections
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" href="/OrganizationsData/Organizations">
                        <i class="bi bi-image me-2"></i>Organizations
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" href="/AdminView/Candidates">
                        <i class="bi bi-person-badge me-2"></i>Candidates
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" href="/AdminView/Voters">
                        <i class="bi bi-people-fill me-2"></i>Voters
                    </a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white" href="/AdminView/Accounts">
                        <i class="bi bi-person-lines-fill me-2"></i>Accounts
                    </a>
                </li>
                <!-- Logout link styled differently to stand out -->
                <li class="nav-item mt-2">
                    <a class="nav-link text-danger fw-bold" href="/Account/Logout">
                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </a>
                </li>
            </ul>

            <!-- Horizontal separator -->
            <hr class="text-secondary" />
            <!-- Contact info or admin email -->
            <div class="small text-white-50">
                <i class="bi bi-envelope-fill me-2"></i>admin@chainvote.com
            </div>
        </nav>

        <!-- Main content area that grows to fill remaining space -->
        <div class="flex-grow-1 p-4" style="margin-left: 250px;">
            <!-- Render the body content from the specific views -->
            @RenderBody()
        </div>
    </div>

    <!-- Bootstrap JavaScript bundle (includes Popper.js) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables JavaScript for enhanced table features -->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

    <!-- Render additional scripts if defined in the views -->
    @RenderSection("Scripts", required: false)
</body>
</html>
