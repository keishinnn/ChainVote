@model ChainVote.Models.ViewModels.ElectionStatsViewModel

@{
    ViewData["Title"] = "Default View Election Results";
    Layout = "~/Views/Shared/_DefaultViewLayout.cshtml";
}

<!-- Container for election results content -->
<div class="container mt-4">

    <!-- Header section displaying election title and dates -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">@Model.EventTitle</h2>
        <p class="text-muted">
            Started on <strong>@Model.EventStartDate.ToString("MMMM dd, yyyy")</strong>
        </p>
        <p class="text-muted">
            Ended on <strong>@Model.EventEndDate.ToString("MMMM dd, yyyy")</strong>
        </p>
        <hr />
    </div>

    <!-- Summary cards showing total voters, votes cast, and voter turnout -->
    <div class="row justify-content-center mb-5">
        <!-- Total eligible voters card -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-uppercase text-muted">Total Eligible Voters</h6>
                    <h3 class="fw-bold">@Model.TotalVoters</h3>
                </div>
            </div>
        </div>

        <!-- Total votes cast card -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-uppercase text-muted">Total Votes Cast</h6>
                    <h3 class="fw-bold text-success">@Model.VotesCast</h3>
                </div>
            </div>
        </div>

        <!-- Voter turnout percentage card -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-uppercase text-muted">Voter Turnout</h6>
                    <h3 class="fw-bold">@Model.VoterTurnoutPercent.ToString("F2")%</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Loop through each position to display candidate results -->
    @foreach (var position in Model.Positions)
    {
        // Find the highest vote count for candidates in this position
        var topVote = position.Candidates.Max(c => c.VoteCount);

        <div class="mb-5">
            <!-- Position title -->
            <h4 class="mb-3 text-primary">@position.PositionTitle</h4>

            <!-- Card container for candidates under the position -->
            <div class="card border-0 shadow-sm">
                <div class="card-body">

                    <!-- Loop candidates sorted by descending votes -->
                    @foreach (var candidate in position.Candidates.OrderByDescending(c => c.VoteCount))
                    {
                        // Determine if this candidate is the winner (has top vote and votes > 0)
                        var isWinner = candidate.VoteCount == topVote && topVote > 0;

                        // Calculate percentage of votes out of total votes cast
                        var percent = Model.VotesCast == 0 ? 0 : ((double)candidate.VoteCount / Model.VotesCast) * 100;

                        // Choose progress bar color based on winning status
                        var progressBarClass = isWinner ? "bg-primary" : "bg-secondary";

                        <div class="mb-3">
                            <!-- Candidate name with winner badge if applicable and vote stats -->
                            <div class="d-flex justify-content-between">
                                <strong class="@(isWinner ? "text-primary" : "")">
                                    @candidate.CandidateName
                                    @if (isWinner)
                                    {
                                        <span class="badge bg-primary ms-2">Winner</span>
                                    }
                                </strong>
                                <span class="text-muted small">@candidate.VoteCount votes (@percent.ToString("F1")%)</span>
                            </div>

                            <!-- Progress bar visually representing vote percentage -->
                            <div class="progress" style="height: 24px;">
                                <div class="progress-bar @progressBarClass" role="progressbar"
                                     style="width: @percent.ToString("F2")%;"
                                     aria-valuenow="@percent.ToString("F0")"
                                     aria-valuemin="0" aria-valuemax="100">
                                    @percent.ToString("F1")%
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Back button to navigate to the elections overview page -->
    <div class="text-end mt-4">
        <a asp-controller="DefaultView" asp-action="DefaultViewElections" class="btn btn-outline-secondary">Back to Elections</a>
    </div>
</div>
