@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_DefaultViewLayout.cshtml";
}

<section class="hero-section text-center text-white bg-primary py-5">
    <div class="container">
        <h1 class="display-3 fw-bold mb-3 animate-fadein">Classroom Blockchain Voting System</h1>
        <p class="lead mb-4 animate-slideup">
            Secure, Transparent, and Built for Academic Voting
        </p>
        <a href="/DefaultView/Login" class="btn btn-light btn-lg me-2">Start Voting</a>
        <a href="/DefaultView/Register" class="btn btn-outline-light btn-lg">Get Verified</a>
    </div>
</section>

<!-- Features Section -->
<section class="features-section py-5 bg-light">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-4 mb-4 animate-fadein">
                <i class="bi bi-lock display-4 text-primary mb-3"></i>
                <h5>Secure Voting</h5>
                <p>Votes are hashed and chained using blockchain for tamper-proof elections.</p>
            </div>
            <div class="col-md-4 mb-4 animate-fadein" style="animation-delay: 0.2s">
                <i class="bi bi-person-check display-4 text-primary mb-3"></i>
                <h5>User Roles</h5>
                <p>Separate login access for Admin and Voter accounts.</p>
            </div>
            <div class="col-md-4 mb-4 animate-fadein" style="animation-delay: 0.4s">
                <i class="bi bi-graph-up display-4 text-primary mb-3"></i>
                <h5>Real-Time Analytics</h5>
                <p>Admins can monitor vote counts, partylist status, and more in real-time.</p>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section class="about-section py-5 text-center">
    <div class="container">
        <h2 class="mb-4">About the System</h2>
        <p class="lead text-muted">
            This project is designed to modernize school and classroom elections using blockchain technology,
            ensuring transparency, accuracy, and accountability with every vote cast.
        </p>
        <a href="/DefaultView/About" class="btn btn-outline-primary mt-3">Learn More</a>
    </div>
</section>
