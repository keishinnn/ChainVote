@{
    ViewData["Title"] = "Elections";
    Layout = "~/Views/Shared/_DefaultViewLayout.cshtml";
    var elections = ViewBag.Elections as List<dynamic>;
}

<section class="elections-section py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-4 fw-bold">Current Elections</h2>

        @if (elections == null || elections.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x display-1 text-muted"></i>
                <h4 class="mt-3">No elections are currently open.</h4>
                <p class="text-muted">Please check again later.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var election in elections)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 animate-fadein" style="transition: transform 0.3s;">
                            <div class="card-body">
                                <h5 class="card-title text-primary fw-bold">@election.Title</h5>
                                <p class="card-text text-muted">@election.Description</p>
                                <div class="mb-2">
                                    <i class="bi bi-calendar-event me-2 text-secondary"></i>
                                    <small class="text-muted">@election.StartDate.ToString("MMM dd, yyyy") - @election.EndDate.ToString("MMM dd, yyyy")</small>
                                </div>

                                <span class="badge bg-@GetStatusColor(election.Status)">
                                    @election.Status
                                </span>
                            </div>
                            <div class="card-footer bg-transparent border-0 text-center">
                                <a href="/Account/Login" class="btn btn-outline-secondary btn-sm">Login to vote</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll(".card").forEach(card => {
            card.addEventListener("mouseenter", () => card.style.transform = "scale(1.02)");
            card.addEventListener("mouseleave", () => card.style.transform = "scale(1)");
        });
    </script>
}

@functions {
    public string GetStatusColor(string status)
    {
        return status switch
        {
            "Ongoing" => "success",
            "Upcoming" => "warning",
            "Ended" => "secondary",
            _ => "dark"
        };
    }
}
