@model ChainVote.Models.AccountViewModels.EditPasswordViewModel

@{
    ViewData["Title"] = "EditPassword";
    Layout = "~/Views/Shared/_UserViewLayout.cshtml";
}

@if (TempData["Error"] != null)
{
    <div class="col-md-12 alert alert-danger">
        <span><b>Sorry!</b> - @TempData["Error"]</span>
    </div>
}

<div class="container mt-5 mb-5 position-relative">

    <a href="/UserView/Settings"
       class="btn btn-outline-dark rounded-circle shadow-sm position-absolute top-0 start-0 mt-4 ms-4"
       title="Back">
        <i class="bi bi-arrow-left"></i>
    </a>

    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow rounded-4">
                <div class="card-body">
                    <h3 class="mb-4 text-dark fw-bold"><i class="bi bi-shield-lock-fill me-2 text-dark"></i>Change Password</h3>

                    <form method="post" asp-action="EditPassword" asp-controller="User">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Current Password</label>
                            <div class="input-group">
                                <input type="password" name="CurrentPassword" class="form-control" placeholder="Enter current password" required id="currentPassword">
                                <button type="button" class="btn btn-outline-secondary" id="toggleCurrentPassword"><i class="bi bi-eye-slash"></i></button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">New Password</label>
                            <div class="input-group">
                                <input type="password" name="NewPassword" id="newPassword" class="form-control" placeholder="Enter new password" required>
                                <button type="button" class="btn btn-outline-secondary" id="toggleNewPassword"><i class="bi bi-eye-slash"></i></button>
                            </div>

                            <!-- New Password Strength Indicators -->
                            <div id="passwordStrength" class="mt-2">
                                <small id="lengthCheck" class="text-danger">❌ At least 8 characters</small><br />
                                <small id="upperCheck" class="text-danger">❌ At least one uppercase letter</small><br />
                                <small id="lowerCheck" class="text-danger">❌ At least one lowercase letter</small><br />
                                <small id="numberCheck" class="text-danger">❌ At least one number</small>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Confirm New Password</label>
                            <div class="input-group">
                                <input type="password" name="ConfirmPassword" id="confirmPassword" class="form-control" placeholder="Re-enter new password" required>
                                <button type="button" class="btn btn-outline-secondary" id="toggleConfirmPassword"><i class="bi bi-eye-slash"></i></button>
                            </div>

                            <!-- Confirm Password Match Indicator -->
                            <div id="matchCheck" class="mt-2">
                                <small id="passwordMatch" class="text-danger">❌ Passwords do not match</small>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill">Change Password</button>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/passwordCriteria.js"></script>
    <script src="~/js/passwordToggle.js"></script>  <!-- Link to the external JS file -->
}
